# Production. Copy to .env.production and fill in every blank.
# Run with:  docker compose --env-file .env.production up -d --build
# Use URL-safe passwords (e.g. `openssl rand -hex 24`): they are embedded in DATABASE_URL / REDIS_URL.
POSTGRES_USER=talentswipe
POSTGRES_PASSWORD=
POSTGRES_DB=talentswipe
REDIS_PASSWORD=

JWT_SECRET=
JWT_REFRESH_SECRET=
LOG_LEVEL=info
# Public origin(s) of the frontend, comma-separated
CORS_ORIGIN=

# Public URL of the API as the browser sees it (inlined at build time)
NEXT_PUBLIC_API_URL=
